# Salin ke .env. Aplikasi memakai user database khusus (bukan root); password root hanya di .kebutuhan untuk membuat database dan user.
PORT=8074
BASE_URL=https://klira.nuscode.id

# Database: nama, user, dan password (user khusus aplikasi, bukan root).
DB_NAME=klira_dev
DB_USER=
DB_PASSWORD=
# Kunci AES-256 (32 byte, base64). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KUNCI_ENKRIPSI=

# Kredensial awal statis akun Pimpinan pertama (2.4); kosongkan untuk memakai bawaan di seed.
USERNAME_AWAL=
KATA_SANDI_AWAL=

# Opsional bila engine dan API berada pada host berbeda. Bawaan memakai ws://127.0.0.1:PORT/api/whatsapp/engine-ws.
# WHATSAPP_WEBSOCKET_URL=wss://klira.example/api/whatsapp/engine-ws

# Instagram resmi (Meta). App ID/Secret dari panel Instagram API, bukan API key Zernio.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Nilai acak yang sama dengan Verify token di dashboard Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Versi mengikuti referensi NC-WA; ubah setelah diuji terhadap versi baru.
INSTAGRAM_GRAPH_VERSION=v23.0
