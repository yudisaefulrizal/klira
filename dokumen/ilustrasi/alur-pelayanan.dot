digraph alur {
  rankdir=TB; nodesep=0.35; ranksep=0.45; splines=true; newrank=true;
  graph [fontname="Lato", fontsize=14, labelloc=t, label="Alur pelayanan klinik pratama dan kebutuhan pihak ketiga", pad=0.3];
  node  [fontname="Lato", fontsize=11, shape=box, style="rounded,filled", color="#555555", penwidth=1.0, margin="0.14,0.08"];
  edge  [fontname="Lato", fontsize=10, color="#444444"];

  subgraph cluster_klinik { label="JALUR KLINIK (pasien dan pelayanan)"; fontsize=13; style="rounded,dashed"; color="#2a6fb0"; fontcolor="#2a6fb0";
  mulai   [label="Pasien datang", shape=oval, fillcolor="#eeeeee"];
  cari    [label="Daftar pasien\ncari pasien", fillcolor="#cfe3f7"];
  ada     [label="Pasien sudah\nterdaftar?", shape=diamond, fillcolor="#cfe3f7", margin="0.05,0.02"];
  reg     [label="Registrasi pasien baru\n(modal bertahap)\nidentitas, data sosial,\ndata kepesertaan JKN,\ngeneral consent", fillcolor="#cfe3f7"];
  kun     [label="Pendaftaran kunjungan\nlayanan, poli/DPJP,\ncara bayar: umum atau JKN\n(nomor SEP boleh menyusul)", fillcolor="#cfe3f7"];
  lay     [label="Jenis layanan?", shape=diamond, fillcolor="#cfe3f7", margin="0.05,0.02"];
  skr     [label="Skrining perawat\ntanda vital", fillcolor="#d3efd5"];
  per     [label="Pemeriksaan klinis dokter\n(modal bertahap + tombol Riwayat)\nanamnesis, diagnosis, tindakan,\nresep, order, rencana tindak lanjut", fillcolor="#d3efd5"];
  sah     [label="Simpan = pengesahan catatan\n(nama akun, jenis akun, waktu, sidik isi)", fillcolor="#d3efd5"];
  perb    [label="Perbaiki catatan, lalu simpan ulang\n(kirim ulang ke SATUSEHAT)\n2x24 jam oleh pembuat;\nsesudahnya perlu persetujuan\nperekam medis/pimpinan", fillcolor="#cfe3f7"];
  lab1    [label="Order lab\n(ditagih saat order)", fillcolor="#fde3c4"];
  lab2    [label="Ambil spesimen\nhasil, interpretasi, validasi", fillcolor="#fde3c4"];
  late    [label="Catatan sudah\ndisahkan?\n(belum: dokter lihat\nhasil di pemeriksaan)", shape=diamond, fillcolor="#fde3c4", margin="0.05,0.02"];
  add     [label="Hasil susulan sebagai\naddendum: versi catatan\n+ pengesahan baru", fillcolor="#d3efd5"];
  inf     [label="Persetujuan tindakan\n(bila tindakan invasif/berisiko tinggi)", fillcolor="#d3efd5"];
  rsp     [label="Telaah resep dan\nsiapkan obat", fillcolor="#e3d5f2"];
  tl      [label="Tindak lanjut?", shape=diamond, fillcolor="#d3efd5", margin="0.05,0.02"];
  pulang  [label="Selesai periksa\n(pulang)", fillcolor="#d3efd5"];
  rujuk   [label="Resume medis dan surat rujukan\nrekam medis ikut rujukan", fillcolor="#d3efd5"];
  adm     [label="Admisi rawat inap\nruang/bed, kelas, DPJP, SPRI", fillcolor="#d3efd5"];
  tutupA  [label="Tutup kunjungan rawat jalan asal\ntagihan digabung ke rawat inap\n(data rawat jalan dikirim)", fillcolor="#fff7d6", style="filled,rounded,bold"];
  ri      [label="Rawat inap: papan bed\ncatatan harian, pindah ruang/kelas,\nDPJP bersama; order lab\ndan obat harian", fillcolor="#d3efd5"];
  plg     [label="Pemulangan rawat inap\ndiagnosis akhir, kondisi pulang,\nresume medis", fillcolor="#d3efd5"];
  kasir   [label="KASIR (akhir pelayanan)\ntagihan: layanan, lab, resep, kamar", fillcolor="#fff0b3", style="filled,rounded,bold"];
  bayar0  [label="Pembayaran\nmetode, jumlah, kwitansi", fillcolor="#fff0b3"];
  serah   [label="Serah terima obat ke pasien\n(bila ada resep)\nstok berkurang", fillcolor="#fff0b3"];
  tutup   [label="TUTUP KUNJUNGAN\npembayaran tercatat (belum bayar:\nperingatan + alasan),\norder lab tercatat dan ditagih;\nbila belum, kembali ke kasir", shape=box, style="filled,bold", penwidth=2.2, fillcolor="#fff7d6"];
  kode    [label="Pengkodean ICD\nPerekam Medis\n(bila kode berubah:\nkirim ulang ke SATUSEHAT)", fillcolor="#cfe3f7"];
  arsip   [label="Arsip rekam medis\nsimpan minimal 25 tahun", shape=oval, fillcolor="#eeeeee"];
  }
  subgraph cluster_p3 { label="JALUR PIHAK KETIGA (SATUSEHAT dan BPJS): tidak menghambat pelayanan"; fontsize=13; style="rounded,dashed"; color="#b07a2a"; fontcolor="#b07a2a";
  jkn [label="Peserta JKN?", shape=diamond, fillcolor="#fff0b3", margin="0.05,0.02"];
  umum [label="Selesai (pasien umum)", shape=oval, fillcolor="#eeeeee"];
  sepq [label="Nomor SEP\nsudah ada?", shape=diamond, fillcolor="#fff0b3", margin="0.05,0.02"];
  tsep [label="Klaim menunggu SEP\n(hitung mundur batas waktu)", fillcolor="#fff0b3"];
  klaim [label="Penyiapan klaim\nSEP, kode, berkas klaim\n(ringkasan RM untuk rawat inap)", fillcolor="#fff0b3"];
  guard [label="Masih dalam\nbatas waktu?", shape=diamond, fillcolor="#fff0b3", margin="0.05,0.02"];
  ajukan [label="Ajukan klaim\npaling lambat 6 bulan\nsejak pelayanan selesai", fillcolor="#fff0b3"];
  hasil [label="Hasil klaim?", shape=diamond, fillcolor="#fff0b3", margin="0.05,0.02"];
  ulang [label="Berkas dikembalikan\nlengkapi, ajukan ulang\npaling lambat bulan berikutnya", fillcolor="#fff0b3"];
  lewat [label="Lewat batas waktu\nklaim tidak dapat diajukan\n(peringatan, catat alasan)", fillcolor="#f6c8c8"];
  tolak [label="Klaim ditolak\ncatat alasan", fillcolor="#f6c8c8"];
  bayar [label="Klaim dibayar", shape=oval, fillcolor="#fff0b3"];
  sat [label="Kirim ke SATUSEHAT otomatis\nantrean, retry, status di kunjungan", fillcolor="#e0e0e0"];
  gal [label="Galat kirim?\nAdmin IT perbaiki", fillcolor="#e0e0e0"];
  }
  mulai -> cari -> ada;
  ada -> reg  [label="belum"];
  ada -> kun  [label="sudah"];
  reg -> kun;
  kun -> lay;
  lay -> skr [label="rawat jalan"];
  lay -> adm [label="langsung\nrawat inap", constraint=false];
  skr -> per -> sah;
  per -> lab1 [label="perlu lab", style=dashed];
  lab1 -> lab2;
  lab2 -> late;
  late -> add [label="sudah"];
  per -> inf  [label="perlu tindakan", style=dashed];
  inf -> sah  [style=dashed, constraint=false];
  per -> rsp  [label="ada resep", style=dashed];
  rsp -> serah [label="obat siap", style=dashed];
  sah -> perb [label="ada kesalahan", style=dashed];
  sah -> tl;
  tl -> pulang [label="pulang"];
  tl -> rujuk  [label="rujuk keluar"];
  tl -> adm    [label="rawat inap"];
  adm -> tutupA [style=dashed, label="dari rawat jalan"];
  adm -> ri -> plg;
  pulang -> kasir;
  rujuk -> kasir;
  plg -> kasir;
  kasir -> bayar0; bayar0 -> serah [label="bila ada resep", style=dashed]; bayar0 -> tutup; serah -> tutup;
  tutup -> kode;
  kode -> arsip;
  jkn -> umum [label="bukan"]; jkn -> sepq [label="ya"];
  sepq -> tsep [label="belum"]; tsep -> sepq [constraint=false];
  tsep -> guard [style=dashed, label="cek batas waktu", constraint=false];
  sepq -> klaim [label="sudah"]; klaim -> guard;
  guard -> ajukan [label="ya"]; guard -> lewat [label="tidak"];
  ajukan -> hasil; hasil -> ulang [label="dikembalikan"]; ulang -> guard [constraint=false];
  hasil -> tolak [label="ditolak"]; hasil -> bayar [label="diterima"];
  sat -> gal [style=dotted]; gal -> sat [style=dotted, label="kirim ulang", constraint=false];
  tutup -> sat [style=dotted, label="otomatis", color="#888888"];
  tutupA -> sat [style=dotted, color="#888888"];
  add -> sat [style=dotted, label="kirim ulang", color="#888888"];
  kode -> jkn [color="#888888"];
    subgraph cluster_leg {
    label="Pelaksana"; fontsize=11; style="rounded"; color="#999999";
    l1 [label="Pendaftaran / Perekam Medis", fillcolor="#cfe3f7"];
    l2 [label="Perawat / Dokter", fillcolor="#d3efd5"];
    l3 [label="Lab", fillcolor="#fde3c4"];
    l4 [label="Farmasi", fillcolor="#e3d5f2"];
    l5 [label="Kasir / Klaim", fillcolor="#fff0b3"];
    l6 [label="Sistem / Admin IT", fillcolor="#e0e0e0"];
    l7 [label="Kegagalan / tidak lanjut", fillcolor="#f6c8c8"];
    l1 -> l2 -> l3 -> l4 -> l5 -> l6 -> l7 [style=invis];
  }
}
