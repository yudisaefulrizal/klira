{
  "name": "klira",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env node_modules/jest/bin/jest.js",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run build -w apps/web && npm run build -w apps/api && node --env-file=.env apps/api/dist/main.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
