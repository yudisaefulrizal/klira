{
  "name": "@klira/db",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "seed": "node ../../skrip/dengan-env.mjs node dist/seed/seed.js",
    "seed:wilayah": "node ../../skrip/dengan-env.mjs node dist/seed/wilayah.js",
    "seed:terminologi": "node ../../skrip/dengan-env.mjs node dist/seed/terminologi.js",
    "migrasi": "node ../../skrip/dengan-env.mjs node dist/migrasi/entry-points/cli.js",
    "seed:demo": "node ../../skrip/dengan-env.mjs node dist/seed/demo.js"
  },
  "dependencies": {
    "@klira/shared": "*",
    "mysql2": "^3.24.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./uji": {
      "types": "./dist/uji/index.d.ts",
      "default": "./dist/uji/index.js"
    }
  }
