{
  "name": "@klira/db",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit",
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrasi:dev": "node ../../skrip/dengan-env.mjs node ../../node_modules/prisma/build/index.js migrate dev",
    "migrasi:terapkan": "node ../../skrip/dengan-env.mjs node ../../node_modules/prisma/build/index.js migrate deploy",
    "seed": "node ../../skrip/dengan-env.mjs node dist/seed/seed.js",
    "seed:wilayah": "node ../../skrip/dengan-env.mjs node dist/seed/wilayah.js",
    "seed:terminologi": "node ../../skrip/dengan-env.mjs node dist/seed/terminologi.js",
    "seed:kfa": "node ../../skrip/dengan-env.mjs node dist/seed/kfa.js"
  },
  "dependencies": {
    "@klira/shared": "*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
