generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Aturan umum: semua entitas membawa fasyankes_id, dibuat_oleh, dibuat_pada (UTC).
// Pada Fasyankes, kolom id adalah fasyankes_id itu sendiri; fasyankes_id diisi sama dengan id.
// Akun, jenis akun, dan penugasan tidak dihapus permanen (aktif / selesai).

enum JenisFasyankes {
  klinik_pratama_rawat_jalan
  klinik_pratama_rawat_inap
}

enum EnvironmentSatusehat {
  sandbox
  produksi
}

enum JenisLokasi {
  poli
  ruang
  bed
}

enum StatusOperasional {
  U // unoperasional
  O // operasional
}

enum AksiIzin {
  input
  perbaikan
  lihat
}

enum CakupanIzin {
  unit
  layanan
}

enum TipeIzinAkun {
  tambah
  kurang
}

enum JenisKelamin {
  laki_laki
  perempuan
}

enum StatusIdentitas {
  lengkap
  sementara
}

enum JenisKunjungan {
  AMB
  IMP
}

enum StatusKunjungan {
  planned
  arrived
  in_progress @map("in-progress")
  finished
}

enum TahapLayanan {
  menunggu_skrining
  pemeriksaan
  resep
  kasir
  ditutup
}

enum CaraPembayaran {
  umum
  jkn
}

enum TipePeserta {
  ATND
  SPRF
}

enum StatusAntrean {
  menunggu
  dipanggil
  dilayani
  selesai
  batal
}

enum JenisPersetujuan {
  general
  tindakan
  pembukaan
  PDP
}

model Fasyankes {
  id                 Int            @id @default(autoincrement())
  fasyankes_id       Int            @unique
  nama               String         @db.VarChar(200)
  jenis              JenisFasyankes
  bentuk_usaha       String?        @db.VarChar(100)
  kode_registrasi    String?        @unique @db.VarChar(50)
  organization_id    String?        @db.VarChar(100)
  status_akreditasi  String?        @db.VarChar(100)
  tanggal_akreditasi DateTime?      @db.Date
  puskesmas_wilayah  String?        @db.VarChar(200)
  dibuat_oleh        Int?
  dibuat_pada        DateTime       @default(now()) @db.DateTime(3)

  kredensial_satusehat KredensialSatusehat[]
  lokasi               Lokasi[]
  pengguna             Pengguna[]
  profil_profesi       ProfilProfesi[]
  pasien               Pasien[]
  wali_keluarga        WaliKeluarga[]
  jenis_akun           JenisAkun[]
  penugasan_jenis      PenugasanJenis[]
  izin_per_akun        IzinPerAkun[]
  peringatan_izin      PeringatanIzin[]
  riwayat_jenis_akun   RiwayatJenisAkun[]
  izin_jenis_akun      IzinJenisAkun[]
  pengaturan_keamanan  PengaturanKeamanan?
  riwayat_backup       RiwayatBackup[]
  jadwal_praktik       JadwalPraktik[]
  tarif_layanan        TarifLayanan[]
  riwayat_profil       RiwayatProfil[]
  kunjungan            Kunjungan[]
  peserta_kunjungan    PesertaKunjungan[]
  antrean              Antrean[]
  persetujuan          Persetujuan[]
  urutan_nomor_rm      UrutanNomorRm?

  @@map("fasyankes")
}

model KredensialSatusehat {
  id                        Int                  @id @default(autoincrement())
  fasyankes_id              Int
  environment               EnvironmentSatusehat
  client_id                 String               @db.VarChar(200)
  client_secret_terenkripsi String               @db.Text
  dibuat_oleh               Int?
  dibuat_pada               DateTime             @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])

  @@unique([fasyankes_id, environment])
  @@map("kredensial_satusehat")
}

model Lokasi {
  id                 Int               @id @default(autoincrement())
  fasyankes_id       Int
  nama               String            @db.VarChar(200)
  jenis              JenisLokasi
  induk_id           Int?
  status_operasional StatusOperasional @default(O)
  ihs_location_id    String?           @db.VarChar(100)
  dibuat_oleh        Int?
  dibuat_pada        DateTime          @default(now()) @db.DateTime(3)

  fasyankes      Fasyankes       @relation(fields: [fasyankes_id], references: [id])
  induk          Lokasi?         @relation("LokasiInduk", fields: [induk_id], references: [id])
  anak           Lokasi[]        @relation("LokasiInduk")
  jadwal_praktik JadwalPraktik[]

  @@index([fasyankes_id])
  @@map("lokasi")
}

model Pengguna {
  id                     Int      @id @default(autoincrement())
  fasyankes_id           Int
  nama                   String   @db.VarChar(200)
  nik                    String   @db.Char(16)
  username               String   @db.VarChar(100)
  kata_sandi_hash        String   @db.VarChar(255)
  aktif                  Boolean  @default(true)
  wajib_ganti_kredensial Boolean  @default(true)
  dibuat_oleh            Int?
  dibuat_pada            DateTime @default(now()) @db.DateTime(3)

  fasyankes       Fasyankes        @relation(fields: [fasyankes_id], references: [id])
  profil_profesi  ProfilProfesi[]
  penugasan_jenis PenugasanJenis[]
  izin_per_akun   IzinPerAkun[]
  peringatan_izin PeringatanIzin[]
  sesi            Sesi[]
  jadwal_praktik  JadwalPraktik[]

  @@unique([fasyankes_id, username])
  @@unique([fasyankes_id, nik])
  @@map("pengguna")
}

model ProfilProfesi {
  id                  Int       @id @default(autoincrement())
  fasyankes_id        Int
  pengguna_id         Int
  profesi             String    @db.VarChar(100)
  nomor_sip           String?   @db.VarChar(100)
  masa_berlaku_sip    DateTime? @db.Date
  ihs_practitioner_id String?   @db.VarChar(100)
  aktif               Boolean   @default(true)
  dibuat_oleh         Int?
  dibuat_pada         DateTime  @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])
  pengguna  Pengguna  @relation(fields: [pengguna_id], references: [id])

  @@index([pengguna_id])
  @@map("profil_profesi")
}

model Pasien {
  id                 Int             @id @default(autoincrement())
  fasyankes_id       Int
  nomor_rm           String          @db.VarChar(50)
  nik                String?         @db.Char(16)
  nama               String          @db.VarChar(200)
  ibu_kandung        String?         @db.VarChar(200)
  tempat_lahir       String?         @db.VarChar(100)
  tanggal_lahir      DateTime        @db.Date
  jenis_kelamin      JenisKelamin
  agama              String?         @db.VarChar(50)
  suku               String?         @db.VarChar(100)
  bahasa             String?         @db.VarChar(100)
  pekerjaan          String?         @db.VarChar(100)
  pendidikan         String?         @db.VarChar(100)
  status_kawin       String?         @db.VarChar(50)
  alamat             String?         @db.Text
  kode_wilayah       String?         @db.VarChar(20)
  nomor_paspor       String?         @db.VarChar(50)
  nomor_kitas        String?         @db.VarChar(50)
  ihs_number         String?         @db.VarChar(100)
  jkn_nomor_kartu    String?         @db.VarChar(50)
  jkn_kelas_hak      String?         @db.VarChar(20)
  jkn_fktp_terdaftar String?         @db.VarChar(200)
  status_identitas   StatusIdentitas @default(lengkap)
  jalur_identitas    String          @default("nik") @db.VarChar(20) // nik | paspor | kitas | tanpa_identitas
  tidak_cakap        Boolean         @default(false)
  dibuat_oleh        Int?
  dibuat_pada        DateTime        @default(now()) @db.DateTime(3)

  fasyankes     Fasyankes        @relation(fields: [fasyankes_id], references: [id])
  wali_keluarga WaliKeluarga[]
  kunjungan     Kunjungan[]
  persetujuan   Persetujuan[]
  keluarga_dari KeluargaPasien[] @relation("KeluargaPasien")
  keluarga_ke   KeluargaPasien[] @relation("KeluargaAnggota")

  @@unique([fasyankes_id, nomor_rm])
  @@unique([fasyankes_id, nik])
  @@index([fasyankes_id, nama])
  @@map("pasien")
}

model WaliKeluarga {
  id           Int      @id @default(autoincrement())
  fasyankes_id Int
  pasien_id    Int
  hubungan     String   @db.VarChar(100)
  nama         String   @db.VarChar(200)
  kontak       String?  @db.VarChar(100)
  dibuat_oleh  Int?
  dibuat_pada  DateTime @default(now()) @db.DateTime(3)

  fasyankes   Fasyankes     @relation(fields: [fasyankes_id], references: [id])
  pasien      Pasien        @relation(fields: [pasien_id], references: [id])
  persetujuan Persetujuan[]

  @@index([pasien_id])
  @@map("wali_keluarga")
}

model JenisAkun {
  id               Int      @id @default(autoincrement())
  fasyankes_id     Int
  nama             String   @db.VarChar(150)
  syarat_profesi   String?  @db.VarChar(200)
  aktif            Boolean  @default(true)
  diubah_oleh      Int?
  alasan_perubahan String?  @db.Text
  dibuat_oleh      Int?
  dibuat_pada      DateTime @default(now()) @db.DateTime(3)

  fasyankes Fasyankes          @relation(fields: [fasyankes_id], references: [id])
  izin      IzinJenisAkun[]
  penugasan PenugasanJenis[]
  riwayat   RiwayatJenisAkun[]

  @@unique([fasyankes_id, nama])
  @@map("jenis_akun")
}

// Daftar izin paket pada jenis akun.
model IzinJenisAkun {
  id            Int      @id @default(autoincrement())
  fasyankes_id  Int
  jenis_akun_id Int
  izin_id       Int
  dibuat_oleh   Int?
  dibuat_pada   DateTime @default(now()) @db.DateTime(3)

  fasyankes  Fasyankes @relation(fields: [fasyankes_id], references: [id])
  jenis_akun JenisAkun @relation(fields: [jenis_akun_id], references: [id])
  izin       Izin      @relation(fields: [izin_id], references: [id])

  @@unique([jenis_akun_id, izin_id])
  @@map("izin_jenis_akun")
}

// Riwayat perubahan jenis akun (tersimpan, tidak dihapus).
model RiwayatJenisAkun {
  id            Int      @id @default(autoincrement())
  fasyankes_id  Int
  jenis_akun_id Int
  ringkasan     String   @db.Text
  alasan        String?  @db.Text
  dibuat_oleh   Int?
  dibuat_pada   DateTime @default(now()) @db.DateTime(3)

  fasyankes  Fasyankes @relation(fields: [fasyankes_id], references: [id])
  jenis_akun JenisAkun @relation(fields: [jenis_akun_id], references: [id])

  @@index([jenis_akun_id])
  @@map("riwayat_jenis_akun")
}

// Katalog izin bersifat global (fitur x aksi x cakupan); fasyankes_id diisi bila khusus klinik.
model Izin {
  id           Int         @id @default(autoincrement())
  fasyankes_id Int?
  fitur        String      @db.VarChar(100)
  aksi         AksiIzin
  cakupan      CakupanIzin
  dibuat_oleh  Int?
  dibuat_pada  DateTime    @default(now()) @db.DateTime(3)

  jenis_akun    IzinJenisAkun[]
  izin_per_akun IzinPerAkun[]
  peringatan    PeringatanIzin[]

  @@unique([fitur, aksi, cakupan])
  @@map("izin")
}

model PenugasanJenis {
  id              Int       @id @default(autoincrement())
  fasyankes_id    Int
  pengguna_id     Int
  jenis_akun_id   Int
  mulai           DateTime  @db.DateTime(3)
  selesai         DateTime? @db.DateTime(3)
  ditetapkan_oleh Int?
  dibuat_oleh     Int?
  dibuat_pada     DateTime  @default(now()) @db.DateTime(3)

  fasyankes  Fasyankes        @relation(fields: [fasyankes_id], references: [id])
  pengguna   Pengguna         @relation(fields: [pengguna_id], references: [id])
  jenis_akun JenisAkun        @relation(fields: [jenis_akun_id], references: [id])
  peringatan PeringatanIzin[]

  @@index([pengguna_id])
  @@map("penugasan_jenis")
}

model IzinPerAkun {
  id              Int          @id @default(autoincrement())
  fasyankes_id    Int
  pengguna_id     Int
  izin_id         Int
  tipe            TipeIzinAkun
  alasan          String       @db.Text
  mulai           DateTime     @db.DateTime(3)
  selesai         DateTime?    @db.DateTime(3)
  ditetapkan_oleh Int?
  dibuat_oleh     Int?
  dibuat_pada     DateTime     @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])
  pengguna  Pengguna  @relation(fields: [pengguna_id], references: [id])
  izin      Izin      @relation(fields: [izin_id], references: [id])

  @@index([pengguna_id])
  @@map("izin_per_akun")
}

model PeringatanIzin {
  id                  Int      @id @default(autoincrement())
  fasyankes_id        Int
  pengguna_id         Int
  izin_id             Int?
  penugasan_id        Int?
  jenis_peringatan    String   @db.VarChar(100)
  alasan_pimpinan     String   @db.Text
  sumber              String   @default("pemberian") @db.VarChar(20) // pemberian | tindakan | terima
  diterima_untuk_akun Boolean  @default(false)
  keterangan          String?  @db.VarChar(255)
  ditetapkan_oleh     Int?
  waktu               DateTime @default(now()) @db.DateTime(3)
  dibuat_oleh         Int?
  dibuat_pada         DateTime @default(now()) @db.DateTime(3)

  fasyankes Fasyankes       @relation(fields: [fasyankes_id], references: [id])
  pengguna  Pengguna        @relation(fields: [pengguna_id], references: [id])
  izin      Izin?           @relation(fields: [izin_id], references: [id])
  penugasan PenugasanJenis? @relation(fields: [penugasan_id], references: [id])

  @@index([pengguna_id])
  @@index([pengguna_id, jenis_peringatan])
  @@map("peringatan_izin")
}

// Sesi masuk: hanya hash id sesi yang disimpan (bukan id mentah).
model Sesi {
  id               Int      @id @default(autoincrement())
  fasyankes_id     Int
  pengguna_id      Int
  id_hash          String   @unique @db.Char(64)
  alamat           String?  @db.VarChar(64)
  dibuat_pada      DateTime @default(now()) @db.DateTime(3)
  kedaluwarsa_pada DateTime @db.DateTime(3)

  pengguna Pengguna @relation(fields: [pengguna_id], references: [id])

  @@index([pengguna_id])
  @@index([kedaluwarsa_pada])
  @@map("sesi")
}

// Log audit dasar (4.7); aksi bebas teks agar memuat masuk/masuk_gagal/keluar selain aksi data.
model LogAudit {
  id           Int      @id @default(autoincrement())
  fasyankes_id Int?
  pengguna_id  Int?
  aksi         String   @db.VarChar(50)
  entitas      String   @db.VarChar(100)
  entitas_id   Int?
  keterangan   String?  @db.VarChar(255)
  waktu        DateTime @default(now()) @db.DateTime(3)
  alamat       String?  @db.VarChar(64)

  @@index([pengguna_id])
  @@index([waktu])
  @@index([fasyankes_id, waktu])
  @@index([aksi, waktu])
  @@index([entitas, entitas_id])
  @@map("log_audit")
}

// Pengaturan keamanan fasyankes (4.9): dibaca auth untuk masa sesi, batas percobaan masuk, dan panjang kata sandi.
model PengaturanKeamanan {
  id                         Int      @id @default(autoincrement())
  fasyankes_id               Int      @unique
  masa_sesi_jam              Int      @default(12)
  batas_percobaan_masuk      Int      @default(5)
  panjang_minimum_kata_sandi Int      @default(8)
  diubah_oleh                Int?
  dibuat_oleh                Int?
  dibuat_pada                DateTime @default(now()) @db.DateTime(3)
  diubah_pada                DateTime @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])

  @@map("pengaturan_keamanan")
}

// Riwayat backup (4.9): hanya dibaca aplikasi web; diisi tugas backup worker.
model RiwayatBackup {
  id           Int      @id @default(autoincrement())
  fasyankes_id Int
  waktu        DateTime @default(now()) @db.DateTime(3)
  status       String   @db.VarChar(20) // berhasil | gagal | berjalan
  ukuran_byte  BigInt?
  lokasi       String?  @db.VarChar(500)
  dibuat_oleh  Int?
  dibuat_pada  DateTime @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])

  @@index([fasyankes_id, waktu])
  @@map("riwayat_backup")
}

enum JenisTarif {
  konsultasi
  tindakan
  lab
  kamar
}

enum TingkatWilayah {
  provinsi
  kabupaten_kota
  kecamatan
  kelurahan_desa
}

// Jadwal praktik (4.2): lokasi_id adalah poli; hari 1 (Senin) sampai 7 (Minggu); jam "HH:MM".
model JadwalPraktik {
  id             Int       @id @default(autoincrement())
  fasyankes_id   Int
  pengguna_id    Int
  lokasi_id      Int
  hari           Int
  jam_mulai      String    @db.VarChar(5)
  jam_selesai    String    @db.VarChar(5)
  kuota          Int
  berlaku_dari   DateTime  @db.Date
  berlaku_sampai DateTime? @db.Date
  aktif          Boolean   @default(true)
  dibuat_oleh    Int?
  dibuat_pada    DateTime  @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])
  pengguna  Pengguna  @relation(fields: [pengguna_id], references: [id])
  lokasi    Lokasi    @relation(fields: [lokasi_id], references: [id])

  @@index([fasyankes_id])
  @@index([pengguna_id])
  @@index([lokasi_id])
  @@map("jadwal_praktik")
}

// Tarif layanan master (4.5); harga dalam rupiah bulat.
model TarifLayanan {
  id           Int        @id @default(autoincrement())
  fasyankes_id Int
  kode         String     @db.VarChar(50)
  nama         String     @db.VarChar(200)
  jenis        JenisTarif
  harga_umum   Int
  harga_jkn    Int?
  aktif        Boolean    @default(true)
  dibuat_oleh  Int?
  dibuat_pada  DateTime   @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])

  @@unique([fasyankes_id, kode])
  @@map("tarif_layanan")
}

// Referensi kode wilayah Kemendagri: global (bukan per fasyankes), hanya baca di aplikasi; diisi lewat skrip impor.
model Wilayah {
  id          Int            @id @default(autoincrement())
  kode        String         @unique @db.VarChar(20)
  nama        String         @db.VarChar(200)
  tingkat     TingkatWilayah
  induk_kode  String?        @db.VarChar(20)
  contoh      Boolean        @default(false)
  dibuat_pada DateTime       @default(now()) @db.DateTime(3)

  @@index([induk_kode])
  @@index([tingkat])
  @@map("wilayah")
}

// Riwayat perubahan profil klinik dan SIP tenaga (4.9); hanya tambah.
model RiwayatProfil {
  id           Int      @id @default(autoincrement())
  fasyankes_id Int
  jenis        String   @db.VarChar(20) // profil | akreditasi | sip
  pengguna_id  Int?
  ringkasan    String   @db.Text
  dibuat_oleh  Int?
  dibuat_pada  DateTime @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])

  @@index([fasyankes_id, dibuat_pada])
  @@map("riwayat_profil")
}

// Nomor RM berurutan per fasyankes: satu baris per fasyankes, dinaikkan di dalam transaksi registrasi.
model UrutanNomorRm {
  id           Int      @id @default(autoincrement())
  fasyankes_id Int      @unique
  terakhir     Int      @default(0)
  dibuat_pada  DateTime @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])

  @@map("urutan_nomor_rm")
}

// Kunjungan (4.2). lokasi_id = poli (kosong untuk rawat inap langsung); mulai/selesai UTC.
model Kunjungan {
  id                Int             @id @default(autoincrement())
  fasyankes_id      Int
  pasien_id         Int
  jenis             JenisKunjungan
  status            StatusKunjungan @default(arrived)
  tahap_layanan     TahapLayanan    @default(menunggu_skrining)
  kunjungan_asal_id Int?
  lokasi_id         Int?
  cara_pembayaran   CaraPembayaran  @default(umum)
  nomor_sep         String?         @db.VarChar(50)
  keluhan_singkat   String?         @db.VarChar(500)
  service_type      String?         @db.VarChar(100)
  encounter_id      String?         @db.VarChar(100)
  mulai             DateTime        @default(now()) @db.DateTime(3)
  selesai           DateTime?       @db.DateTime(3)
  waktu_tutup       DateTime?       @db.DateTime(3)
  dibuat_oleh       Int?
  dibuat_pada       DateTime        @default(now()) @db.DateTime(3)

  fasyankes     Fasyankes          @relation(fields: [fasyankes_id], references: [id])
  pasien        Pasien             @relation(fields: [pasien_id], references: [id])
  asal          Kunjungan?         @relation("KunjunganAsal", fields: [kunjungan_asal_id], references: [id])
  lanjutan      Kunjungan[]        @relation("KunjunganAsal")
  peserta       PesertaKunjungan[]
  antrean       Antrean?
  anamnesis     Anamnesis[]
  observasi     Observasi[]
  diagnosis     Diagnosis[]
  tindakan      Tindakan[]
  tindak_lanjut TindakLanjut[]
  order_penunjang OrderPenunjang[]
  tagihan       Tagihan?

  @@index([fasyankes_id, tahap_layanan])
  @@index([pasien_id])
  @@map("kunjungan")
}

model PesertaKunjungan {
  id           Int         @id @default(autoincrement())
  fasyankes_id Int
  kunjungan_id Int
  pengguna_id  Int
  tipe         TipePeserta
  mulai        DateTime    @default(now()) @db.DateTime(3)
  selesai      DateTime?   @db.DateTime(3)
  dibuat_oleh  Int?
  dibuat_pada  DateTime    @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])
  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@index([kunjungan_id])
  @@index([pengguna_id])
  @@map("peserta_kunjungan")
}

// Antrean otomatis per poli per hari (tanggal zona Asia/Jakarta); nomor urut 1.. diformat A-001.
model Antrean {
  id            Int           @id @default(autoincrement())
  fasyankes_id  Int
  kunjungan_id  Int           @unique
  lokasi_id     Int
  tanggal       DateTime      @db.Date
  nomor         Int
  status        StatusAntrean @default(menunggu)
  waktu_daftar  DateTime      @default(now()) @db.DateTime(3)
  waktu_panggil DateTime?     @db.DateTime(3)
  waktu_mulai   DateTime?     @db.DateTime(3)
  waktu_selesai DateTime?     @db.DateTime(3)
  dibuat_oleh   Int?
  dibuat_pada   DateTime      @default(now()) @db.DateTime(3)

  fasyankes Fasyankes @relation(fields: [fasyankes_id], references: [id])
  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@unique([fasyankes_id, lokasi_id, tanggal, nomor])
  @@index([fasyankes_id, tanggal, status])
  @@map("antrean")
}

// Master teks persetujuan berversi (4.9). fasyankes_id kosong = teks bawaan semua klinik.
model TeksPersetujuan {
  id           Int              @id @default(autoincrement())
  fasyankes_id Int?
  jenis        JenisPersetujuan
  versi        Int
  judul        String           @db.VarChar(200)
  tujuan       String           @db.VarChar(500)
  isi          String           @db.Text
  aktif        Boolean          @default(true)
  dibuat_oleh  Int?
  dibuat_pada  DateTime         @default(now()) @db.DateTime(3)

  persetujuan Persetujuan[]

  @@index([jenis, aktif])
  @@map("teks_persetujuan")
}

// Persetujuan (4.4). Teks yang disetujui disimpan lewat teks_persetujuan_id (versi teks tidak berubah).
model Persetujuan {
  id                  Int              @id @default(autoincrement())
  fasyankes_id        Int
  pasien_id           Int
  jenis               JenisPersetujuan
  teks_persetujuan_id Int?
  versi_teks          Int
  tujuan              String           @db.VarChar(500)
  penjelasan          String?          @db.Text
  bentuk              String           @db.VarChar(20) // tertulis | lisan
  status              String           @default("diberikan") @db.VarChar(20)
  waktu               DateTime         @default(now()) @db.DateTime(3)
  penandatangan       String           @db.VarChar(20) // pasien | wali
  wali_id             Int?
  penandatangan_nama  String           @db.VarChar(200)
  saksi_pengguna_id   Int?
  // Persetujuan tindakan: kunjungan dan tindakan yang disetujui (kosong untuk general consent).
  kunjungan_id        Int?
  tindakan_kode       String?          @db.VarChar(50)
  tindakan_nama       String?          @db.VarChar(255)
  dibuat_oleh         Int?
  dibuat_pada         DateTime         @default(now()) @db.DateTime(3)

  fasyankes Fasyankes        @relation(fields: [fasyankes_id], references: [id])
  pasien    Pasien           @relation(fields: [pasien_id], references: [id])
  teks      TeksPersetujuan? @relation(fields: [teks_persetujuan_id], references: [id])
  wali      WaliKeluarga?    @relation(fields: [wali_id], references: [id])

  @@index([pasien_id])
  @@index([kunjungan_id])
  @@map("persetujuan")
}

// ---- Catatan klinis (4.2). Tiap bagian berversi: perubahan menambah baris versi baru, tidak ada UPDATE atau DELETE.
// Versi aktif = versi tertinggi. Pengesahan dan versi catatan bersifat generik (entitas + entitas_id), dipakai ulang CPPT, resume, hasil lab.

enum KelompokObservasi {
  tanda_vital
  pemeriksaan
}

enum PeranDiagnosis {
  utama
  penyerta
}

enum JenisTindakLanjut {
  pulang
  rujuk
  rawat_inap
}

enum SistemTerminologi {
  icd10
  icd9cm
  loinc
  snomed
  ucum
}

enum JenisFavorit {
  diagnosis
  tindakan
  resep
}

enum BagianTemplat {
  anamnesis
  pemeriksaan
}

model Anamnesis {
  id               Int      @id @default(autoincrement())
  fasyankes_id     Int
  kunjungan_id     Int
  versi            Int
  keluhan_utama    String   @db.Text
  penyerta         String?  @db.Text
  riwayat_pribadi  String?  @db.Text
  riwayat_keluarga String?  @db.Text
  alergi           String?  @db.Text
  dibuat_oleh      Int?
  dibuat_pada      DateTime @default(now()) @db.DateTime(3)

  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@unique([kunjungan_id, versi])
  @@map("anamnesis")
}

model Observasi {
  id           Int               @id @default(autoincrement())
  fasyankes_id Int
  kunjungan_id Int
  kelompok     KelompokObservasi
  versi        Int
  bidang       String            @db.VarChar(50)
  kode_loinc   String?           @db.VarChar(20)
  nilai        String            @db.Text
  satuan_ucum  String?           @db.VarChar(30)
  waktu        DateTime          @default(now()) @db.DateTime(3)
  dibuat_oleh  Int?
  dibuat_pada  DateTime          @default(now()) @db.DateTime(3)

  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@unique([kunjungan_id, kelompok, versi, bidang])
  @@map("observasi")
}

model Diagnosis {
  id           Int            @id @default(autoincrement())
  fasyankes_id Int
  kunjungan_id Int
  versi        Int
  kode_icd10   String         @db.VarChar(20)
  nama         String         @db.VarChar(500)
  kode_snomed  String?        @db.VarChar(30)
  peran        PeranDiagnosis
  urutan       Int
  dibuat_oleh  Int?
  dibuat_pada  DateTime       @default(now()) @db.DateTime(3)

  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@unique([kunjungan_id, versi, urutan])
  @@index([fasyankes_id, kode_icd10])
  @@map("diagnosis")
}

model Tindakan {
  id           Int       @id @default(autoincrement())
  fasyankes_id Int
  kunjungan_id Int
  versi        Int
  kode_icd9cm  String    @db.VarChar(20)
  nama         String    @db.VarChar(500)
  performer_id Int?
  mulai        DateTime  @db.DateTime(3)
  selesai      DateTime? @db.DateTime(3)
  urutan       Int
  dibuat_oleh  Int?
  dibuat_pada  DateTime  @default(now()) @db.DateTime(3)

  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@unique([kunjungan_id, versi, urutan])
  @@map("tindakan")
}

model TindakLanjut {
  id           Int               @id @default(autoincrement())
  fasyankes_id Int
  kunjungan_id Int
  versi        Int
  jenis        JenisTindakLanjut
  tujuan       String?           @db.VarChar(300)
  spri         String?           @db.VarChar(100)
  catatan      String?           @db.Text
  dibuat_oleh  Int?
  dibuat_pada  DateTime          @default(now()) @db.DateTime(3)

  kunjungan Kunjungan @relation(fields: [kunjungan_id], references: [id])

  @@unique([kunjungan_id, versi])
  @@map("tindak_lanjut")
}

// Versi catatan (4.2): isi lama yang digantikan beserta alasan perbaikan; disetujui_oleh kosong bila pembuat memperbaiki dalam 2x24 jam.
model VersiCatatan {
  id             Int      @id @default(autoincrement())
  fasyankes_id   Int
  entitas        String   @db.VarChar(50)
  entitas_id     Int
  versi          Int
  isi_lama       Json
  alasan         String   @db.Text
  disetujui_oleh Int?
  dibuat_oleh    Int?
  dibuat_pada    DateTime @default(now()) @db.DateTime(3)

  @@unique([entitas, entitas_id, versi])
  @@map("versi_catatan")
}

// Pengesahan catatan (4.2): pengganti tanda tangan nakes. jenis_akun_id kosong bila hak berasal dari izin tambahan akun.
model PengesahanCatatan {
  id              Int      @id @default(autoincrement())
  fasyankes_id    Int
  entitas         String   @db.VarChar(50)
  entitas_id      Int
  versi           Int
  pengguna_id     Int
  jenis_akun_id   Int?
  jenis_akun_nama String?  @db.VarChar(150)
  waktu           DateTime @default(now()) @db.DateTime(3)
  hash            String   @db.Char(64)
  dibuat_oleh     Int?
  dibuat_pada     DateTime @default(now()) @db.DateTime(3)

  @@unique([entitas, entitas_id, versi])
  @@index([pengguna_id])
  @@map("pengesahan_catatan")
}

// Master terminologi sederhana (4.8), global. `contoh` menandai baris contoh; kode lengkap diimpor lewat CSV.
model KodeTerminologi {
  id     Int               @id @default(autoincrement())
  sistem SistemTerminologi
  kode   String            @db.VarChar(40)
  nama   String            @db.VarChar(500)
  aktif  Boolean           @default(true)
  contoh Boolean           @default(false)

  @@unique([sistem, kode])
  @@map("kode_terminologi")
}

model FavoritDokter {
  id           Int          @id @default(autoincrement())
  fasyankes_id Int
  pengguna_id  Int
  jenis        JenisFavorit
  kode         String       @db.VarChar(50)
  nama         String       @db.VarChar(255)
  urutan       Int          @default(0)
  dibuat_oleh  Int?
  dibuat_pada  DateTime     @default(now()) @db.DateTime(3)

  @@unique([pengguna_id, jenis, kode])
  @@map("favorit_dokter")
}

model TemplatCatatan {
  id           Int           @id @default(autoincrement())
  fasyankes_id Int
  pengguna_id  Int
  bagian       BagianTemplat
  nama         String        @db.VarChar(100)
  isi          Json
  dibuat_oleh  Int?
  dibuat_pada  DateTime      @default(now()) @db.DateTime(3)

  @@index([pengguna_id, bagian])
  @@map("templat_catatan")
}

// Draf alur klinis (4.2): isi sementara per alur, pengguna, dan kunjungan; satu draf aktif. Tidak pernah masuk audit atau dikirim ke SATUSEHAT.
model Draf {
  id               Int      @id @default(autoincrement())
  fasyankes_id     Int
  pengguna_id      Int
  alur             String   @db.VarChar(50)
  kunjungan_id     Int
  pasien_id        Int
  langkah_terakhir Int      @default(0)
  isi              Json
  diperbarui_pada  DateTime @default(now()) @db.DateTime(3)
  dibuat_oleh      Int?
  dibuat_pada      DateTime @default(now()) @db.DateTime(3)

  @@unique([pengguna_id, alur, kunjungan_id])
  @@index([kunjungan_id])
  @@map("draf")
}

// Family folder (4.9): tautan antarpasien dalam satu fasyankes dengan penanda privasi per anggota.
model KeluargaPasien {
  id                Int      @id @default(autoincrement())
  fasyankes_id      Int
  pasien_id         Int
  anggota_pasien_id Int
  hubungan          String   @db.VarChar(100)
  dibatasi          Boolean  @default(false)
  dibuat_oleh       Int?
  dibuat_pada       DateTime @default(now()) @db.DateTime(3)

  pasien  Pasien @relation("KeluargaPasien", fields: [pasien_id], references: [id])
  anggota Pasien @relation("KeluargaAnggota", fields: [anggota_pasien_id], references: [id])

  @@unique([pasien_id, anggota_pasien_id])
  @@map("keluarga_pasien")
}

// ---- Penunjang (4.3), tagihan dasar (4.5), dan addendum (4.2).

enum StatusOrderPenunjang {
  dipesan
  spesimen_diambil
  menunggu_hasil
  divalidasi
}

enum StatusTagihan {
  belum_lengkap
  lengkap
}

enum StatusPembayaran {
  belum
  sebagian
  lunas
}

// Master pemeriksaan penunjang lokal (4.9): satuan UCUM dan rentang rujukan klinik; harga lewat tarif_layanan (jenis lab).
// loinc_contoh menandai kode LOINC contoh (bukan hasil impor resmi).
model MasterPemeriksaan {
  id               Int       @id @default(autoincrement())
  fasyankes_id     Int
  kode             String    @db.VarChar(50)
  nama             String    @db.VarChar(200)
  jenis            String    @default("lab") @db.VarChar(20)
  kode_loinc       String?   @db.VarChar(30)
  loinc_contoh     Boolean   @default(false)
  jenis_spesimen   String?   @db.VarChar(100)
  satuan           String?   @db.VarChar(50)
  rujukan_min      Float?
  rujukan_maks     Float?
  rujukan_teks     String?   @db.VarChar(200)
  tarif_layanan_id Int?
  aktif            Boolean   @default(true)
  dibuat_oleh      Int?
  dibuat_pada      DateTime  @default(now()) @db.DateTime(3)
  diubah_pada      DateTime? @db.DateTime(3)

  order OrderPenunjang[]

  @@unique([fasyankes_id, kode])
  @@map("master_pemeriksaan")
}

// Satu baris per pemeriksaan yang dipesan; status hanya maju. Nama, kode LOINC, dan prioritas disalin saat order.
model OrderPenunjang {
  id                     Int                  @id @default(autoincrement())
  fasyankes_id           Int
  kunjungan_id           Int
  pasien_id              Int
  jenis                  String               @default("lab") @db.VarChar(20)
  master_pemeriksaan_id  Int?
  kode_loinc             String?              @db.VarChar(30)
  nama                   String               @db.VarChar(200)
  prioritas              String               @default("rutin") @db.VarChar(20)
  catatan                String?              @db.VarChar(500)
  status                 StatusOrderPenunjang @default(dipesan)
  dibuat_oleh            Int?
  dibuat_pada            DateTime             @default(now()) @db.DateTime(3)

  kunjungan Kunjungan          @relation(fields: [kunjungan_id], references: [id])
  master    MasterPemeriksaan? @relation(fields: [master_pemeriksaan_id], references: [id])
  spesimen  Spesimen?
  hasil     HasilPenunjang?

  @@index([fasyankes_id, status])
  @@index([kunjungan_id])
  @@map("order_penunjang")
}

model Spesimen {
  id           Int      @id @default(autoincrement())
  fasyankes_id Int
  order_id     Int      @unique
  asal         String   @db.VarChar(100)
  waktu_ambil  DateTime @db.DateTime(3)
  petugas_id   Int
  dibuat_oleh  Int?
  dibuat_pada  DateTime @default(now()) @db.DateTime(3)

  order OrderPenunjang @relation(fields: [order_id], references: [id])

  @@map("spesimen")
}

// Hasil dapat diisi ulang sampai divalidasi; sesudah divalidasi tidak diubah (susulan lewat addendum).
model HasilPenunjang {
  id              Int       @id @default(autoincrement())
  fasyankes_id    Int
  order_id        Int       @unique
  nilai           String    @db.VarChar(200)
  satuan          String?   @db.VarChar(50)
  rujukan_teks    String?   @db.VarChar(200)
  interpretasi    String    @db.VarChar(30)
  catatan         String?   @db.VarChar(1000)
  dientri_oleh    Int
  dientri_pada    DateTime  @default(now()) @db.DateTime(3)
  validator_id    Int?
  divalidasi_pada DateTime? @db.DateTime(3)

  order OrderPenunjang @relation(fields: [order_id], references: [id])

  @@map("hasil_penunjang")
}

// Tagihan dasar per kunjungan (4.5): item dibuat saat order; status tagihan (lengkap bila semua item berharga) terpisah dari pembayaran.
model Tagihan {
  id                Int              @id @default(autoincrement())
  fasyankes_id      Int
  kunjungan_id      Int              @unique
  status_tagihan    StatusTagihan    @default(belum_lengkap)
  status_pembayaran StatusPembayaran @default(belum)
  dibuat_oleh       Int?
  dibuat_pada       DateTime         @default(now()) @db.DateTime(3)

  kunjungan Kunjungan     @relation(fields: [kunjungan_id], references: [id])
  item      ItemTagihan[]

  @@map("tagihan")
}

model ItemTagihan {
  id                  Int        @id @default(autoincrement())
  fasyankes_id        Int
  tagihan_id          Int
  jenis               JenisTarif
  tarif_layanan_id    Int?
  kode                String     @db.VarChar(50)
  nama                String     @db.VarChar(200)
  jumlah              Int        @default(1)
  harga               Int?
  order_penunjang_id  Int?       @unique
  dibuat_oleh         Int?
  dibuat_pada         DateTime   @default(now()) @db.DateTime(3)

  tagihan Tagihan @relation(fields: [tagihan_id], references: [id])

  @@index([tagihan_id])
  @@map("item_tagihan")
}

// Addendum (4.2): isi susulan setelah catatan disahkan (mis. hasil lab); hanya menambah, versi per entitas. Pengesahan barunya di pengesahan_catatan (entitas `addendum`).
model Addendum {
  id                 Int       @id @default(autoincrement())
  fasyankes_id       Int
  kunjungan_id       Int
  entitas            String    @db.VarChar(50)
  entitas_id         Int
  versi              Int
  isi                Json
  alasan             String    @db.VarChar(500)
  waktu              DateTime  @default(now()) @db.DateTime(3)
  perlu_kirim_ulang  Boolean   @default(true)
  dikirim_pada       DateTime? @db.DateTime(3)
  dibuat_oleh        Int?
  dibuat_pada        DateTime  @default(now()) @db.DateTime(3)

  @@unique([entitas, entitas_id, versi])
  @@index([kunjungan_id])
  @@map("addendum")
}
